{
    "name": "justinholtweb/craft-headdy",
    "description": "A token-authenticated headless storefront API for Craft Commerce — REST and GraphQL cart, checkout and payment mutations for Next, Nuxt and Astro front ends.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "headless",
        "storefront",
        "api",
        "rest",
        "graphql",
        "jamstack"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://justinholt.com/plugins/craft-headdy/docs",
        "source": "https://github.com/justinholtweb/craft-headdy",
        "issues": "https://github.com/justinholtweb/craft-headdy/issues",
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\headdy\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "name": "Headdy",
        "handle": "headdy",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-headdy/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-headdy/main/CHANGELOG.md",
        "class": "justinholtweb\\headdy\\Plugin"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "phpstan": "phpstan --memory-limit=1G"
    }
}
